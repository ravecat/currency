{
  "name": "currency",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --passthrough-arguments \"pnpm run typecheck:watch\" \"pnpm run dev:server {@}\" --",
    "dev:server": "vite",
    "build": "pnpm run typecheck && vite build && storybook build --disable-telemetry",
    "preview": "vite preview",
    "storybook": "concurrently --kill-others --passthrough-arguments \"pnpm run typecheck:watch\" \"pnpm run storybook:server {@}\" --",
    "storybook:server": "storybook dev --port 6006 --ci --disable-telemetry",
    "format": "oxlint --fix && oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "typecheck": "tsc -b",
    "typecheck:watch": "concurrently --kill-others \"tsc -p tsconfig.app.json --watch --preserveWatchOutput\" \"tsc -p tsconfig.node.json --watch --preserveWatchOutput\"",
    "test": "pnpm run typecheck && vitest run"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^10.29.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/preact-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.0.5",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright": "1.59.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.27.0"
  },
  "packageManager": "pnpm@11.27.0"
}
